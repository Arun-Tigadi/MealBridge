# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB connection URI (e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/mealbridge?retryWrites=true&w=majority)
# If not provided, MealBridge gracefully runs on high-fidelity embedded state store
MONGO_URI="mongodb://localhost:27017/mealbridge"

# JWT secret key for signing authentication tokens
JWT_SECRET="mealbridge-belagavi-secure-jwt-key"

# Port (configured to 3000)
PORT="3000"

# ==============================================================================
# EMAIL DELIVERY PROVIDER CONFIGURATION (Required for live OTP email dispatch)
# If unconfigured, MealBridge explicitly reports unconfigured status and never
# pretends an email was sent.
# ==============================================================================
# Option A: Resend API (Recommended)
RESEND_API_KEY=""
RESEND_FROM="MealBridge <onboarding@resend.dev>"

# Option B: SendGrid API
SENDGRID_API_KEY=""
SENDGRID_FROM="noreply@mealbridge.org"

# Option C: SMTP Transport
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@mealbridge.org"

# ==============================================================================
# MOBILE SMS OTP PROVIDER CONFIGURATION (Twilio / MSG91)
# Prepared integration interface for legitimate SMS OTP delivery.
# Verification will not claim to work until provider is configured and tested.
# ==============================================================================
# Option A: Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Option B: MSG91
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
